# Pixel SystemUI's back-gesture classifier (libtensorflowlite_jni.so in SystemUI.apk) is built for a newer CPU than the Exynos 9611: the lib dies with SIGILL (illegal instruction) in
# tflite::jni::BufferErrorReporter, SystemUI crash-loops and the screen stays black as soon as gesture navigation is on. Without the ML model SystemUI uses the plain edge-swipe back gesture.
# The donor DeviceConfig default is false, but GMS may explicitly set it true. Keep this existing boot hint.
# The M30s Pixel static SystemUI overlay also forces config_useBackGestureML=false before the flag check, so flag sync cannot admit the crashing model.
service gesture_noml /system/bin/cmd device_config put systemui use_back_gesture_ml_model false
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start gesture_noml
