<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.m30s.precompile" android:sharedUserId="android.uid.system">
    <application android:label="Precompile apps" android:icon="@android:drawable/ic_popup_sync" android:hasCode="true">
        <activity android:name=".Go" android:exported="true" android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".Tile" android:exported="true" android:label="Precompile apps" android:icon="@android:drawable/ic_popup_sync" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
    </application>
</manifest>
